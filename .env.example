# Copy to apps/api/.env and apps/web/.env.local as needed.

# --- Database (Docker Compose defaults) ---
DATABASE_URL=postgresql://sr:sr_dev_password@localhost:5432/sr_social_hub?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
COOKIE_SECURE=false

# --- Seeded bootstrap (local only) ---
SUPER_ADMIN_EMAIL=admin@srsocialhub.local
SUPER_ADMIN_PASSWORD=ChangeMeAdmin!123
DEMO_COMPANY_EMAIL=agency@srsocialhub.local
DEMO_COMPANY_PASSWORD=ChangeMeAgency!123
DEMO_CLIENT_EMAIL=client@srsocialhub.local
DEMO_CLIENT_PASSWORD=ChangeMeClient!123

# --- Social OAuth ---
# mock = local architecture verification (default when credentials missing)
# live = real provider OAuth when admin-configured credentials exist
SOCIAL_OAUTH_MODE=mock

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
