{
  "name": "sr-social-hub",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @sr/api --filter @sr/web dev",
    "dev:api": "pnpm --filter @sr/api dev",
    "dev:web": "pnpm --filter @sr/web dev",
    "build": "pnpm -r --filter @sr/shared --filter @sr/api --filter @sr/web build",
    "test": "pnpm -r --filter @sr/api --filter @sr/web test",
    "lint": "pnpm -r --filter @sr/api --filter @sr/web lint",
    "db:migrate": "pnpm --filter @sr/api prisma:migrate",
    "db:generate": "pnpm --filter @sr/api prisma:generate",
    "db:seed": "pnpm --filter @sr/api prisma:seed"
  }
}
